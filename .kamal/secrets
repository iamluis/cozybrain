# Kamal secrets — referenced from config/deploy.yml.
# DO NOT put raw credentials here. Pull from env, the local file system, or
# a password-manager adapter. This file IS committed to git.

# Container registry password (GitHub PAT with `write:packages` for GHCR).
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Rails master key — decrypts config/credentials.yml.enc.
RAILS_MASTER_KEY=$(cat config/master.key)

# Action Mailbox ingress password — the email forwarder authenticates with
# this on its webhook POST. Generate once with `bin/rails credentials:edit`
# and store under `action_mailbox.ingress_password`, then either:
#   - export RAILS_INBOUND_EMAIL_PASSWORD=… in your shell, or
#   - pull from credentials: RAILS_INBOUND_EMAIL_PASSWORD=$(bin/rails credentials:fetch action_mailbox.ingress_password)
RAILS_INBOUND_EMAIL_PASSWORD=$RAILS_INBOUND_EMAIL_PASSWORD

# Litestream — when you wire up SQLite replication.
# LITESTREAM_ACCESS_KEY_ID=$LITESTREAM_ACCESS_KEY_ID
# LITESTREAM_SECRET_ACCESS_KEY=$LITESTREAM_SECRET_ACCESS_KEY
