<div class="auth-page stack">
  <% if alert = flash[:alert] %>
    <p class="flash flash--alert" id="alert"><%= alert %></p>
  <% end %>

  <h1>Forgot your password?</h1>

  <%= form_with url: passwords_path, class: "stack" do |form| %>
    <div class="field">
      <%= form.label :email_address, "Email", class: "field__label" %>
      <%= form.email_field :email_address,
            required: true,
            autofocus: true,
            autocomplete: "username",
            value: params[:email_address],
            class: "input" %>
    </div>

    <%= form.submit "Email reset instructions", class: "button button--primary button--full" %>
  <% end %>
</div>
