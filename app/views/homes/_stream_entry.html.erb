<% target = stream_entry_target(entry) %>
<li class="stream__row" id="stream_entry_<%= entry.proof_side ? "f#{entry.proof_side.id}" : "t#{entry.money_side.id}" %>">
  <% if target.present? %>
    <%= link_to target, class: "stream__entry stream__entry--link" do %>
      <%= render "stream_entry_body", entry: entry %>
    <% end %>
  <% else %>
    <div class="stream__entry">
      <%= render "stream_entry_body", entry: entry %>
    </div>
  <% end %>
</li>
