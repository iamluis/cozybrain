<% invoice = item %>
<div class="tray__item tray__item--invoice">
  <div class="tray__item-head">
    <span class="tray__item-title">
      Draft invoice · <%= invoice.client_name %>
    </span>
    <span class="tray__item-from">
      <%= invoice.period_label %> · €<%= number_with_precision(invoice.total, precision: 2, delimiter: ",") %>
    </span>
  </div>

  <div class="tray__actions">
    <%= button_to "Send",
          send_to_client_invoice_path(invoice),
          method: :post,
          form: { class: "tray__pill-form" },
          class: "tray__pill tray__pill--send" %>
    <%= link_to "Edit", invoice_path(invoice), class: "tray__pill tray__pill--quiet" %>
  </div>
</div>
