<tr class="invoice__line">
  <td class="invoice__cell invoice__cell--desc">
    <%= lf.hidden_field :id %>
    <%= lf.hidden_field :position %>
    <%= lf.hidden_field :_destroy, value: "0" %>
    <%= lf.text_field :description,
          class: "invoice__input invoice__input--desc",
          placeholder: "What was the work?",
          data: { action: "input->invoice-lines#fieldChanged" } %>
  </td>
  <td class="invoice__cell invoice__cell--num">
    <%= lf.text_field :quantity,
          value: format_quantity(line.quantity),
          inputmode: "decimal",
          autocomplete: "off",
          class: "invoice__input invoice__input--num",
          placeholder: "0",
          data: { action: "input->invoice-lines#fieldChanged" } %>
  </td>
  <td class="invoice__cell invoice__cell--num">
    <%= lf.text_field :unit_amount,
          value: format_money(line.unit_amount),
          inputmode: "decimal",
          autocomplete: "off",
          class: "invoice__input invoice__input--num",
          placeholder: "0.00",
          data: { action: "input->invoice-lines#fieldChanged" } %>
  </td>
  <td class="invoice__cell invoice__cell--amt invoice__line-amount">
    <%= display_money(line.quantity.to_f * line.unit_amount.to_f) %>
  </td>
  <td class="invoice__cell invoice__cell--rm">
    <button type="button" class="invoice__remove" data-action="invoice-lines#removeRow" aria-label="Remove line">×</button>
  </td>
</tr>
