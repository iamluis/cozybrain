<tr class="invoice__line">
  <td>
    <%= lf.hidden_field :id %>
    <%= lf.hidden_field :position %>
    <%= lf.hidden_field :_destroy, value: "0" %>
    <%= lf.text_field :description, class: "invoice__input invoice__input--desc", placeholder: "What was the work?", data: { action: "input->invoice-lines#fieldChanged" } %>
  </td>
  <td>
    <%= lf.number_field :quantity, step: 0.01, class: "invoice__input invoice__input--qty", placeholder: "0", data: { action: "input->invoice-lines#fieldChanged" } %>
  </td>
  <td>
    <div class="invoice__rate-cell">
      <span class="invoice__rate-currency">€</span>
      <%= lf.number_field :unit_amount,
            value: line.unit_amount,
            step: 0.01,
            class: "invoice__input invoice__input--rate",
            placeholder: "0.00",
            data: { action: "input->invoice-lines#fieldChanged" } %>
    </div>
  </td>
  <td class="invoice__line-amount">
    €<%= number_with_precision((line.quantity.to_f * line.unit_amount.to_f), precision: 2, delimiter: ",") %>
  </td>
  <td class="invoice__line-remove">
    <button type="button" class="invoice__remove" data-action="invoice-lines#removeRow" aria-label="Remove line">×</button>
  </td>
</tr>
