<div class="invoice__lines-wrap">
  <table class="invoice__lines">
    <thead>
      <tr>
        <th class="invoice__col-desc">Description</th>
        <th class="invoice__col-qty">Quantity</th>
        <th class="invoice__col-rate">Rate</th>
        <th class="invoice__col-amt">Amount</th>
        <th class="invoice__col-rm" aria-hidden="true"></th>
      </tr>
    </thead>
    <tbody data-invoice-lines-target="rows">
      <%= f.fields_for :line_items do |lf| %>
        <%= render "line_row", lf: lf, line: lf.object %>
      <% end %>
    </tbody>
  </table>

  <div class="invoice__add-row">
    <button type="button" class="invoice__add-line" data-action="invoice-lines#addRow">
      + Add a line
    </button>
  </div>

  <template data-invoice-lines-target="template">
    <%= f.fields_for :line_items,
          IssuedInvoiceLineItem.new(position: 99, quantity: 1, unit_amount_cents: 0),
          child_index: "NEW_RECORD" do |lf| %>
      <%= render "line_row", lf: lf, line: lf.object %>
    <% end %>
  </template>
</div>
