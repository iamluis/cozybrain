<% content_for :title, "Invoices" %>

<div class="invoices-page">
  <header class="invoices__head">
    <h1 class="invoices__title">Invoices</h1>
  </header>

  <% if @draft.present? %>
    <section class="invoices__draft">
      <div class="invoices__draft-head">
        <span class="invoices__draft-label">Draft · <%= @draft.period_label %></span>
        <%= link_to "Open →", invoice_path(@draft), class: "invoices__draft-open" %>
      </div>
      <div class="invoices__draft-row">
        <span class="invoices__draft-client"><%= @draft.display_client_name %></span>
        <span class="num invoices__draft-amount"><%= display_money(@draft.total) %></span>
      </div>
    </section>
  <% else %>
    <section class="invoices__draft invoices__draft--empty">
      <%= button_to "Start the next invoice",
            invoices_path,
            method: :post,
            params: { period_year: @next_period.first, period_month: @next_period.last },
            form: { class: "invoice-start-form" },
            class: "button button--primary button--small" %>
    </section>
  <% end %>

  <% if @historical.any? %>
    <section class="invoices__history">
      <h2 class="invoices__section-label">Earlier</h2>
      <ul class="invoices__list">
        <% @historical.each do |invoice| %>
          <li class="invoices__row">
            <%= link_to invoice_path(invoice), class: "invoices__entry" do %>
              <span class="invoices__number num">#<%= invoice.number %></span>
              <span class="invoices__client"><%= invoice.display_client_name %></span>
              <span class="invoices__period num"><%= invoice.period_label %></span>
              <span class="invoices__amount num"><%= display_money(BigDecimal(invoice.amount_cents) / 100) %></span>
              <span class="entry__pill entry__pill--<%= invoice.invoice_status %>"><%= invoice.invoice_status %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>
