<div class="auth-page stack">
  <% if alert = flash[:alert] %>
    <p class="flash flash--alert" id="alert"><%= alert %></p>
  <% end %>
  <% if notice = flash[:notice] %>
    <p class="flash flash--notice" id="notice"><%= notice %></p>
  <% end %>

  <h1>Sign in</h1>

  <%= form_with url: session_url, class: "stack" do |form| %>
    <div class="field">
      <%= form.label :email_address, "Email", class: "field__label" %>
      <%= form.email_field :email_address,
            required: true,
            autofocus: true,
            autocomplete: "username",
            value: params[:email_address],
            class: "input" %>
    </div>

    <div class="field">
      <%= form.label :password, "Password", class: "field__label" %>
      <%= form.password_field :password,
            required: true,
            autocomplete: "current-password",
            maxlength: 72,
            class: "input" %>
    </div>

    <%= form.submit "Sign in", class: "button button--primary button--full" %>
  <% end %>

  <p class="meta">
    <%= link_to "Forgot password?", new_password_path %>
  </p>
</div>
