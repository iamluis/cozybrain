<% content_for :title, "Capture receipt" %>

<%= form_with model: @receipt, multipart: true do |f| %>
  <div class="page stack">
    <% if @receipt.errors.any? %>
      <div class="errors">
        <%= pluralize(@receipt.errors.count, "thing") %> needs fixing:
        <ul>
          <% @receipt.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="field">
      <%= f.label :amount, class: "field__label" %>
      <div class="amount">
        <span class="amount__currency">€</span>
        <%= f.number_field :amount,
              step: 0.01,
              inputmode: "decimal",
              autocomplete: "off",
              placeholder: "0.00",
              class: "amount__input" %>
      </div>
    </div>

    <div class="row">
      <%= f.label :original_photo, class: "photo" do %>
        <span aria-hidden="true">📷</span>
        <span>Photo of receipt</span>
        <%= f.file_field :original_photo, accept: "image/*", capture: "environment" %>
      <% end %>
      <%= f.date_field :paid_on, class: "date-chip" %>
    </div>

    <div class="field">
      <%= f.label :vendor, class: "field__label" %>
      <%= f.text_field :vendor,
            autocomplete: "off",
            placeholder: "Where",
            class: "input" %>
    </div>

    <div class="grid-2">
      <div class="field">
        <%= f.label :country, class: "field__label" %>
        <%= f.select :country,
              Receipt::COUNTRIES,
              { include_blank: "—" },
              class: "select" %>
      </div>
      <div class="field">
        <%= label_tag "receipt[note]", "Note", class: "field__label" %>
        <%= text_field_tag "receipt[note]", nil,
              placeholder: "Optional",
              autocomplete: "off",
              class: "input" %>
      </div>
    </div>
  </div>

  <div class="bar-bottom">
    <div class="bar-bottom__inner">
      <%= f.submit "Save  →  next", class: "button button--primary button--full" %>
    </div>
  </div>
<% end %>
