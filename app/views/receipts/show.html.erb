<% content_for :title, "Saved" %>

<div class="page stack">
  <% if flash[:notice].blank? %>
    <div class="saved">
      <span aria-hidden="true">✓</span>
      <span>Saved</span>
    </div>
  <% end %>

  <%= render "card", receipt: @receipt %>

  <div class="grid-2">
    <%= link_to "Add another", new_receipt_path, class: "button button--primary button--full" %>
    <%= link_to "Done",        root_path,        class: "button button--full" %>
  </div>
</div>
