<% content_for :title, "Saved" %>

<div class="page stack">
  <% if flash[:notice].blank? %>
    <div class="saved">
      <span aria-hidden="true">✓</span>
      <span>Saved</span>
    </div>
  <% end %>

  <%= render "card", receipt: @receipt %>

  <div class="card-actions">
    <%= link_to "Capture another", new_receipt_path, class: "button button--primary button--small" %>
    <%= link_to "Home",            root_path,        class: "button--quiet" %>
  </div>
</div>
